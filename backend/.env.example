# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# JWT (REQUIRED - generate a strong random string)
JWT_SECRET=your-256-bit-random-secret-here
JWT_EXPIRY=7d

# MongoDB
MONGODB_URI=mongodb://localhost:27017/tilv

# Redis
REDIS_URL=redis://localhost:6379

# Mantle Network
MANTLE_RPC_URL=https://rpc.mantle.xyz
MANTLE_CHAIN_ID=5000
PRIVATE_KEY=

# Contract Addresses (verified Mantle mainnet deployment)
INVOICE_NFT_ADDRESS=0x504D3dcc9fe0dbD38f6EbC0509a09fb578dFa3A7
VAULT_MANAGER_ADDRESS=0x8FafC9dAc6342310fFd87497aCa9D405142EaA6D
RISK_ENGINE_ADDRESS=0x95768Da9D39E4D9E1B1E7C76F7091ceeb6404Ddd
AGENT_CONTROLLER_ADDRESS=0x42E1DDa459F2c38AdEefd82DA0C9cc1373bFdDBF
USDT_ADDRESS=0x201EBa5CC46D216Ce6DC03F6a759e8E766e956aE

# AI Service
AI_SERVICE_URL=http://localhost:5000

# CORS
