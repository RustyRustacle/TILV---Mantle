# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# JWT (REQUIRED - generate a strong random string)
JWT_SECRET=your-256-bit-random-secret-here
JWT_EXPIRY=7d

# MongoDB
MONGODB_URI=mongodb://localhost:27017/tilv

# Redis
REDIS_URL=redis://localhost:6379

# Mantle Network
MANTLE_RPC_URL=https://rpc.testnet.mantle.xyz
MANTLE_CHAIN_ID=5001
PRIVATE_KEY=

# Contract Addresses (fill after deployment)
INVOICE_NFT_ADDRESS=
VAULT_MANAGER_ADDRESS=
RISK_ENGINE_ADDRESS=
AGENT_CONTROLLER_ADDRESS=
USDT_ADDRESS=0x201EBa5CC46D216Ce6DC03F6a759e8E766e956aE

# AI Service
AI_SERVICE_URL=http://localhost:5000

# CORS
CORS_ORIGIN=http://localhost:3000

# File Uploads
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
