{
    "compilerOptions": {
        "target": "ES2020",
        "module": "Node16",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "moduleResolution": "node16",
        "types": [
            "node"
        ]
    },
    "include": [
        "./scripts",
        "./test",
        "./hardhat.config.ts"
    ],
    "files": [
        "./hardhat.config.ts"
    ]
}