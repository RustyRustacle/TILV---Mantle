MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT (REQUIRED - generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_JWT_SECRET

# WalletConnect (REQUIRED - get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Network
MANTLE_RPC_URL=https://rpc.mantle.xyz
MANTLE_CHAIN_ID=5000

# API
CORS_ORIGIN=https://localhost
NEXT_PUBLIC_API_URL=https://localhost

# TLS reverse proxy
# Use localhost for local HTTPS with Caddy's local certificate.
# Use your public domain on a server with DNS pointed at it for automatic Let's Encrypt TLS.
CADDY_SITE_ADDRESS=localhost

